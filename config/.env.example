# Vainelú: plantilla sin credenciales reales.
# Copiar al archivo de entorno local que utilice el proyecto y mantenerlo fuera de Git.
# El servidor controla el modo. Nunca permitir que una petición del cliente lo cambie.
# Modos previstos: demo, test, production. La configuración inicial sólo demuestra la experiencia.
APP_MODE=demo
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase: dejar vacío en demo. Para test, utilizar un proyecto separado de producción.
# La publishable key puede estar en el cliente; la secret key sólo puede usarse en servidor.
# No añadir el prefijo NEXT_PUBLIC a ninguna clave secreta.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Stripe: dejar vacío en demo. Conectar únicamente credenciales de prueba al configurar test.
# Verificar la firma del webhook con el secreto del endpoint y entorno correspondientes.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Activar pagos de prueba requiere una configuración test válida.
# Cambiar estos flags por sí solo nunca debe habilitar ventas sin datos comerciales verificados.
PAYMENTS_ENABLED=false
REAL_SALES_ENABLED=false

# log registra o simula las notificaciones sin enviar correos ni mensajes externos.
NOTIFICATIONS_MODE=log

# Completar únicamente con el correo real del propietario al ejecutar el alta administrativa controlada.
# Esta variable no debe permitir registro público ni conceder privilegios desde el navegador.
ADMIN_BOOTSTRAP_EMAIL=

# Generar secretos largos, aleatorios y diferentes para las funciones conectadas que los requieran.
# Si están vacíos, bloquear esas funciones; nunca recurrir a secretos predeterminados o públicos.
JOBS_AUTH_SECRET=
GUEST_TOKEN_SECRET=

# Lista explícita separada por comas. No usar * para las operaciones autenticadas.
# Sustituir por los orígenes reales verificados al configurar otro entorno.
ALLOWED_ORIGINS=http://localhost:3000

# Configuración Stripe de sandbox dedicada, solo con métodos basados en tarjeta.
# Verificar en el Dashboard antes de probar; no se proporciona un identificador ficticio.
STRIPE_CARD_PAYMENT_CONFIGURATION=
